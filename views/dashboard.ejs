<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PADAYON | Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FAF6F0;
            --card: #F3EBE0;
            --text: #4A3728;
            --muted: #8a7565;
            --accent: #C4704F;
            --accent2: #8FA98A;
            --line: #e2d6c6;
            --shadow: 0 6px 20px rgba(74, 55, 40, .10);
        }

        [data-theme=dark] {
            --bg: #2A2320;
            --card: #362D28;
            --text: #F3E9DC;
            --muted: #b9a793;
            --accent: #E0906E;
            --accent2: #9DB898;
            --line: #4b3f38;
            --shadow: 0 6px 20px rgba(0, 0, 0, .35);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Nunito', 'Quicksand', system-ui, sans-serif;
            line-height: 1.5;
            transition: background .3s, color .3s;
        }

        h1,
        h2 {
            margin: 0;
        }

        h1 {
            font-size: 1.6rem;
            font-weight: 800;
        }

        h2 {
            font-size: 1.15rem;
            margin-bottom: .6rem;
        }

        #app {
            max-width: 680px;
            margin: 0 auto;
            padding: 16px;
        }

        header {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
            align-items: center;
        }

        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }

        .tag {
            margin: 0;
            color: var(--muted);
            font-size: .9rem;
        }

        .card {
            background: var(--card);
            border-radius: 22px;
            padding: 20px;
            margin: 16px 0;
            box-shadow: var(--shadow);
        }

        label {
            display: block;
            font-weight: 700;
            font-size: .9rem;
            margin-top: 10px;
        }

        input,
        textarea {
            width: 100%;
            min-height: 44px;
            margin-top: 4px;
            padding: 10px 14px;
            border: 2px solid var(--line);
            border-radius: 14px;
            background: var(--bg);
            color: var(--text);
            font: inherit;
            resize: none;
        }

        input:focus,
        textarea:focus,
        .btn:focus-visible,
        summary:focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 2px;
        }

        fieldset {
            border: 0;
            padding: 0;
            margin: 0;
        }

        fieldset:disabled {
            opacity: .45;
        }

        .grid2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        @media(max-width: 480px) {
            .grid2 {
                grid-template-columns: 1fr;
            }
        }

        .btn {
            min-height: 44px;
            padding: 8px 18px;
            border: 2px solid var(--line);
            border-radius: 999px;
            background: var(--bg);
            color: var(--text);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            transition: transform .15s, background .2s;
        }

        .btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }

        .btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

        .btn.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
            margin: 8px 0;
        }

        .note {
            color: var(--muted);
            font-size: .85rem;
        }

        .err {
            color: #c0392b;
            font-weight: 700;
            min-height: 1.2em;
            margin: 6px 0;
        }

        .pill {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 999px;
            background: var(--accent2);
            color: #1f2a1d;
            font-size: .8rem;
            font-weight: 700;
            margin: 2px 4px 2px 0;
        }

        .pill button {
            border: 0;
            background: none;
            cursor: pointer;
            font-weight: 800;
            color: inherit;
            min-width: 24px;
        }

        .switch {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 700;
            cursor: pointer;
            margin: 0;
            min-height: 44px;
        }

        .switch input {
            width: 20px;
            min-height: 20px;
            margin: 0;
            accent-color: var(--accent);
        }

        .focus-card {
            border: 3px solid var(--accent);
            animation: glow 3s ease-in-out infinite;
            text-align: center;
            padding: 28px 20px;
        }

        .focus-card h2 {
            font-size: 1.6rem;
            margin: 10px 0;
        }

        .badge {
            background: var(--accent);
            color: #fff;
            padding: 4px 14px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 800;
        }

        .empty {
            font-size: 2.4rem;
        }

        @keyframes glow {
            50% {
                box-shadow: 0 0 28px rgba(196, 112, 79, .45);
            }
        }

        @keyframes slide {
            from {
                opacity: 0;
                transform: translateY(-16px);
            }
        }

        .slide {
            animation: slide .4s ease;
        }

        .list {
            list-style: none;
            padding: 0;
            margin: 8px 0 0;
        }

        .list li {
            padding: 10px 14px;
            border-radius: 14px;
            background: var(--bg);
            margin-bottom: 8px;
            opacity: .75;
        }

        summary {
            cursor: pointer;
            font-weight: 800;
            min-height: 44px;
        }

        dialog {
            border: 0;
            border-radius: 22px;
            background: var(--card);
            color: var(--text);
            max-width: 420px;
            width: 90%;
            padding: 22px;
            box-shadow: var(--shadow);
        }

        dialog::backdrop {
            background: rgba(0, 0, 0, .4);
        }

        #app.focus #upnext,
        #app.focus #hist {
            display: none;
        }

        @media(prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }

        [hidden] {
            display: none !important;
        }
    </style>
</head>

<body>

    <div id="app">
        <header>
            <div>
                <h1>PADAYON</h1>
                <p class="tag">A Smart Task Manager</p>
            </div>
            <div class="controls">
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    <a href="/admin" class="btn" style="background: transparent;">Admin Panel</a>
                <% } %>
                <label class="switch">
                    <input type="checkbox" id="focusToggle">
                    <span>Focus Mode</span>
                </label>
                <button class="btn" id="themeBtn">Night</button>
                <a href="/logout" class="btn">Sign out</a>
            </div>
        </header>

        <p id="who" class="who">Signed in as <%= typeof email !== 'undefined' ? email : '' %></p>

        <main>
            <section class="card" id="addCard">
                <h2>New Task</h2>
                <p id="focusNote" class="note" hidden>Focus Mode is on. Finish your current task first, then add more.</p>
                <form id="form" novalidate>
                    <fieldset id="fs">
                        <label>Title
                            <input id="title" maxlength="80" placeholder="e.g. Finishing ITE 300 Activity" required>
                        </label>
                        <label>Description
                            <textarea id="desc" rows="2" maxlength="300" placeholder="Optional details"></textarea>
                        </label>
                        <label>Tags ex: Module, Review
                            <input id="tagIn" maxlength="25" placeholder="e.g. Bodybuilding">
                        </label>
                        <div class="row">
                            <span id="tagCount" class="note">0/25</span>
                            <span id="pills"></span>
                        </div>
                        <div class="grid2">
                            <label>Deadline *
                                <input type="datetime-local" id="deadline" required>
                            </label>
                            <label>Estimated minutes *
                                <input type="number" id="mins" min="1" max="1440" placeholder="30" required>
                            </label>
                        </div>
                        <p id="err" class="err" role="alert"></p>
                        <button class="btn primary" type="submit">Add to Top</button>
                    </fieldset>
                </form>
            </section>

            <section id="focusCard" class="card focus-card" aria-live="polite"></section>

            <section id="upnext" class="card">
                <h2>Up Next</h2>
                <ul id="list" class="list"></ul>
            </section>

            <section id="hist" class="card">
                <details>
                    <summary>Completed (<span id="hCount">0</span>)</summary>
                    <button class="btn" id="undoBtn">Undo last completion</button>
                    <p class="note">Undo moves a task back to the top. Redo isn't supported — mark it done again instead.</p>
                    <ul id="hlist" class="list"></ul>
                </details>
            </section>
        </main>
    </div>

    <dialog id="dlg">
        <div id="dlgBody"></div>
        <p class="note">Just looking! Nothing was changed.</p>
        <button class="btn primary" id="dlgClose">Close</button>
    </dialog>

    <script src="/app.js"></script>
</body>

</html>